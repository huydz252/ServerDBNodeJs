<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    /* Style riêng cho trang này */
    .choices label { display: inline-block; margin-right: 15px; }
    .choices input[type="radio"] { margin-right: 5px; }
  </style>
</head>
<body>
  <a href="/admin/quizzes/<%= question.quizId %>">&larr; Quay lại bộ đề</a>
  <a href="/auth/logout" class="logout-link">Đăng xuất</a>
  
  <h1>Chỉnh sửa câu hỏi (ID: <%= question.id %>)</h1>

  <hr>

  <form action="/admin/questions/<%= question.id %>/edit" method="POST">
    <div>
      <label for="questionText">Nội dung câu hỏi:</label>
      <textarea id="questionText" name="questionText" rows="3" required><%= question.questionText %></textarea>
    </div>
    
    <h4>Các lựa chọn</h4>
    <div>
      <label for="option1">A:</label>
      <input type="text" id="option1" name="option1" value="<%= question.options[0] %>" required>
    </div>
    <div>
      <label for="option2">B:</label>
      <input type="text" id="option2" name="option2" value="<%= question.options[1] %>" required>
    </div>
    <div>
      <label for="option3">C:</label>
      <input type="text" id="option3" name="option3" value="<%= question.options[2] %>" required>
    </div>
    <div>
      <label for="option4">D:</label>
      <input type="text" id="option4" name="option4" value="<%= question.options[3] %>" required>
    </div>

    <h4>Đáp án đúng:</h4>
    <div class="choices">
      <input type="radio" id="correctA" name="correctAnswerIndex" value="0" 
             <%= (question.correctAnswerIndex === 0) ? 'checked' : '' %>>
      <label for="correctA">A</label>
      
      <input type="radio" id="correctB" name="correctAnswerIndex" value="1"
             <%= (question.correctAnswerIndex === 1) ? 'checked' : '' %>>
      <label for="correctB">B</label>
      
      <input type="radio" id="correctC" name="correctAnswerIndex" value="2"
             <%= (question.correctAnswerIndex === 2) ? 'checked' : '' %>>
      <label for="correctC">C</label>

      <input type="radio" id="correctD" name="correctAnswerIndex" value="3"
             <%= (question.correctAnswerIndex === 3) ? 'checked' : '' %>>
      <label for="correctD">D</label>
    </div>
    
    <button type="submit" style="margin-top: 10px;">Lưu thay đổi</button>
  </form>

</body>
</html>